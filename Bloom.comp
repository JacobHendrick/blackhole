#version 430 core
layout(local_size_x = 16, local_size_y = 8) in;
layout(binding = 0, rgba16f) writeonly uniform image2D outBloom;
layout(binding = 0) uniform sampler2D uNative;
layout(binding = 1) uniform sampler2D uPreviewImage;
layout(binding = 3) uniform sampler2D uBloomSource;
uniform int uPass;
vec3 scene(vec2 uv) {
    vec4 high = textureLod(uNative, uv, 0.0);
    return high.a > 0.5 ? high.rgb : textureLod(uPreviewImage, uv, 0.0).rgb;
}
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outBloom);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec3 color;
    if (uPass == 0) {
        vec2 d = 0.5 / vec2(textureSize(uNative, 0));
        color = 0.25 * (scene(uv + d) + scene(uv - d)
                      + scene(uv + vec2(d.x, -d.y)) + scene(uv + vec2(-d.x, d.y)));
        float brightness = max(max(color.r, color.g), color.b);
        color *= smoothstep(0.65, 1.4, brightness);
    } else {
        vec2 axis = uPass == 1 ? vec2(1.0 / size.x, 0.0) : vec2(0.0, 1.0 / size.y);
        color = textureLod(uBloomSource, uv, 0.0).rgb * 0.227027;
        color += (textureLod(uBloomSource, uv + axis * 1.384615, 0.0).rgb
                + textureLod(uBloomSource, uv - axis * 1.384615, 0.0).rgb) * 0.316216;
        color += (textureLod(uBloomSource, uv + axis * 3.230769, 0.0).rgb
                + textureLod(uBloomSource, uv - axis * 3.230769, 0.0).rgb) * 0.070270;
    }
    imageStore(outBloom, pixel, vec4(color, 1.0));
}
